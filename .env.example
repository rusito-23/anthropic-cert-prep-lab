ANTHROPIC_API_KEY=sk-ant-...

# Default model for exercises in this repo. Kept cheap (Haiku) to conserve
# tokens during practice — override per-run by exporting a different value.
ANTHROPIC_MODEL=claude-haiku-4-5

# Default max_tokens for exercises. 1024 leaves room for more than a one-line
# reply without spending much — raise it per-exercise if a response gets cut
# off (stop_reason: "max_tokens").
ANTHROPIC_MAX_TOKENS=1024
